rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
        return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isVendor() {
        return isSignedIn() && exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }
    
    function isAssignedVendor(userId) {
      return get(/databases/$(database)/documents/customers/$(userId)).data.vendorId == request.auth.uid;
    }
    
    function isAssignedStaff(userId) {
      return get(/databases/$(database)/documents/customers/$(userId)).data.assignedStaffId == request.auth.uid;
    } 
    
    function isCorporate() {
        return isSignedIn() && exists(/databases/$(database)/documents/corporates/$(request.auth.uid));
    }
    
   function isCorporateWithCustomer(userId) {
        let customerDoc = get(/databases/$(database)/documents/customers/$(userId));
        return customerDoc.exists && customerDoc.data.corporateId == request.auth.uid;
    }
    
    function isEventOwner(eventId) {
      let eventDoc = get(/databases/$(database)/documents/corporateEvents/$(eventId));
      return eventDoc.exists && eventDoc.data.corporateId == request.auth.uid;
    }

    // Admins have full access to their own collection
    match /admins/{adminId} {
      allow read: if isSignedIn(); // MODIFIED: Allowed read for all signed-in users
      allow write: if isOwner(adminId) || isAdmin();
    }

    // Staff can be read by admin/staff, managed by admin.
    match /staff/{staffId} {
      allow read: if isSignedIn(); // MODIFIED: Allowed read for all signed-in users
      allow write: if isAdmin() || isOwner(staffId);
    }
    
    // Vendor collection
    match /vendors/{vendorId} {
        allow read: if isSignedIn(); // MODIFIED: Allowed read for all signed-in users
        allow write: if isAdmin() || request.auth.uid == vendorId;
    }

    // Corporates can be read by admin, managed by admin.
    match /corporates/{corporateId} {
      allow read, write: if isAdmin();
      allow read, update: if isOwner(corporateId); // Corporate user can read/update their own profile
    }

   // Customers collection
   match /customers/{customerId} {
      // READ: User can read their own doc, assigned staff can read, vendor can read, admin can read, corporate can read.
      allow read: if isSignedIn() && (
        request.auth.uid == customerId ||
        isAdmin() ||
        (isStaff() && resource.data.assignedStaffId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/vendors/$(request.auth.uid)) && resource.data.vendorId == request.auth.uid) ||
        (isCorporate() && resource.data.corporateId == request.auth.uid)
      );
      
      // Allow list for admin and staff
      allow list: if isAdmin() || isStaff() || isVendor() || isCorporate();

      // WRITE: User can update their own doc, admin can write, vendor can update.
      allow write: if isSignedIn() && (
        request.auth.uid == customerId || isAssignedStaff(customerId) ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/vendors/$(request.auth.uid)) && resource.data.vendorId == request.auth.uid)
      );
      
      // Allow create for anonymous users (registration) or if authorized corporate
      allow create: if true;
    }
    
    match /customers/{userId}/{anySubCollection}/{docId} {
       allow read, write: if isOwner(userId) || isAdmin() || isAssignedVendor(userId) || isAssignedStaff(userId) ;
       allow read: if isStaff() && get(/databases/$(database)/documents/customers/$(userId)).data.assignedStaffId == request.auth.uid;
    }
    
   // User Profiles
   match /userProfiles/{userId} {
      // MODIFIED: Merged duplicated rules together
      allow read: if isOwner(userId) || isAdmin() || isStaff() || isAssignedVendor(userId) || isCorporateWithCustomer(userId);
      allow write: if isOwner(userId) || isAdmin();
      allow create: if true;
    }

    // Subscription plans are managed by Admin
    match /subscriptionPlans/{planId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin();
    }

   // Rules for 'dietPlans' collection
    match /dietPlans/{planId} {
      // allow read: if request.auth != null; // Allow any authenticated user to read
      allow read: if request.auth != null && (get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.dietPlanId == planId || isAdmin() || isStaff() || isVendor());
      allow write: if isAdmin() || (isStaff() && resource.data.createdBy == request.auth.uid) || (isVendor() && resource.data.createdBy == request.auth.uid);
      allow create: if isAdmin() || isStaff() || isVendor();
      allow delete: if isAdmin() || (isStaff() && resource.data.createdBy == request.auth.uid) || (isVendor() && resource.data.createdBy == request.auth.uid);
    }
    
    match /customers/{customerId}/dietPlanHistory/{historyId} {
       allow read: if isOwner(customerId) || isAdmin() || isAssignedVendor(customerId);
       allow create: if isAssignedStaff(customerId) || isAdmin();
    }
    
    match /users/{userId}/dieticianPlanLogs/{logId} {
        allow read: if isOwner(userId) || isAdmin() || isStaff() || isAssignedVendor(userId);
        allow write: if isOwner(userId);
    }

    match /users/{userId}/selfDietPlans/{logId} {
        allow read, write: if isOwner(userId) || isAdmin() || isStaff();
    }
    
    match /users/{userId}/activityLogs/{logId} {
        allow read: if isOwner(userId) || isAdmin() || isStaff() || isAssignedVendor(userId);
        allow write: if isOwner(userId);
    }
    
    match /dailyWeightLogs/{logId} {
        allow read: if resource.data.userId == request.auth.uid || isAdmin() || isStaff() || isAssignedVendor(resource.data.userId);
        allow create: if request.resource.data.userId == request.auth.uid;
        allow delete: if resource.data.userId == request.auth.uid;
    }
    
    match /measurementLogs/{logId} {
        allow read: if resource.data.userId == request.auth.uid || isAdmin() || isStaff() || isAssignedVendor(resource.data.userId);
        allow create: if request.resource.data.userId == request.auth.uid;
    }
    
     match /users/{userId}/{anySubCollection}/{docId} {
       allow read, write: if isOwner(userId) || isAdmin();
       allow read: if isStaff() && get(/databases/$(database)/documents/customers/$(userId)).data.assignedStaffId == request.auth.uid || isAssignedVendor(userId);
    }
    
    // Support tickets
    match /supportTickets/{ticketId} {
        allow create: if isSignedIn();
        allow read, update: if isAdmin() || isOwner(resource.data.userId);
        allow list: if request.query.where.userId == request.auth.uid || isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
    
    match /meetings/{meetingId} {
        allow read, write: if isAdmin() || isStaff();
    }
    
    match /subscriptionHistory/{historyId} {
      allow read: if resource.data.userId == request.auth.uid || isAdmin() || isVendor();
      allow create: if true;
    }
    
    match /expenses/{expenseId} {
        allow read, write: if isAdmin();
    }
    
    match /events/{eventId} {
        allow read: if true; // Publicly readable for registration
        allow create, write, delete: if isAdmin();
    }
    
    match /corporateEvents/{eventId} {
        allow list: if isCorporate() && request.query.where.corporateId == request.auth.uid;
        allow read: if isCorporate(); 
        allow create: if isCorporate();
        allow write, delete: if isAdmin() || isEventOwner(eventId);
    }
    
    match /corporateEvents/{eventId}/registrations/{registrationId} {
        allow read, list: if isEventOwner(eventId) || isAdmin();
        allow create: if true; // Public registration
        
        match /scores/{scoreId} {
            allow read: if isEventOwner(eventId) || isAdmin();
            allow write: if isEventOwner(eventId);
        }
    }
    
    match /customers/{customerId}/scores/{scoreId} {
        allow read: if isOwner(customerId) || isAdmin() || isStaff() || isAssignedVendor(customerId) || isCustomerCorporate(customerId);
        allow write: if isAdmin() || isCustomerCorporate(customerId);
    }

    match /settings/global {
      allow read: if true; // Everyone can read settings
      allow write: if isAdmin(); // Only admins can change settings
    }
    
    match /app-logs/{logId} {
      allow read: if isAdmin();
      allow write: if true; // Allows server-side flows to write logs
    }
    
    match /scores/{scoreId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /partnerEnquiries/{enquiryId} {
      allow read: if isVendor() && resource.data.partnerId == request.auth.uid;
      allow create: if isVendor() && request.resource.data.partnerId == request.auth.uid;
    }
    
    match /fitbossRegistrations/{registrationId} {
        allow create: if true;
        allow read, write: if isAdmin();
    }
    
    // Public write for contact form submissions
    match /contactSubmissions/{submissionId} {
        allow create: if true;
        allow read, update: if isAdmin();
    }
  }
}
